# ── Discord bot ────────────────────────────────────────────────────────────────
# Token from https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token

# ID of the Discord channel the bot listens to for seed files
TARGET_CHANNEL_ID=123456789012345678

# ── API ────────────────────────────────────────────────────────────────────────
# Master key to manage tokens via /admin endpoints (min 16 characters)
ADMIN_KEY=change-me-to-a-long-random-secret

# Comma-separated list of origins allowed by CORS (your frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000
